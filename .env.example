# Banco de dados (provisionado pela integração Neon na Vercel)
DATABASE_URL=

# Autenticação (Better Auth) — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Opcional: URL canônica da aplicação (ex.: domínio próprio em produção)
BETTER_AUTH_URL=

# Opcional: nível mínimo de log (debug | info | warn | error)
LOG_LEVEL=info
